APP_NAME=integrations-service
APP_VERSION=0.1.0
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stocksync_integrations
DB_ECHO=false
REDIS_URL=redis://localhost:6379/0
MERCADO_LIVRE_APP_ID=
MERCADO_LIVRE_CLIENT_SECRET=
# Shopee Open Platform Console → App List → seu app (Partner ID / Partner Key)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Produção: https://partner.shopeemobile.com | Sandbox: https://partner.test-stable.shopeemobile.com
SHOPEE_API_HOST=https://partner.shopeemobile.com
# Domínio precisa estar cadastrado como Redirect URL Domain no app do Console
SHOPEE_REDIRECT_URL=http://localhost:5173/api/v1/auth/shopee/callback
FRONTEND_URL=http://localhost:5173
CATALOG_SERVICE_URL=http://localhost:8001

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=